// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  sessionId String   @id
  userId    String
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family Family?

  session Session[]
}

model Family {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  members Member[]
}

model Member {
  id           String       @id @default(uuid())
  familyId     String
  name         String
  dob          DateTime
  gender       Gender?      @default(Male)
  relationship Relationship
  bloodGroup   BloodGroup?
  phoneNumber  String?
  createdAt    DateTime     @default(now())
  deletedAt    DateTime?

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  medicalRecords MedicalRecord[]

  medications Medication[]

  appointments Appointment[]

  @@unique([familyId, name, dob, relationship])
}

model RecordType {
  id   String @id @default(uuid())
  name String @unique

  medicalRecords MedicalRecord[]
}

model Doctor {
  id         String   @id @default(uuid())
  name       String
  speciality String
  phone      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospitalMappings DoctorHospitalMapping[]
  medicalRecords   MedicalRecord[]
  appointments     Appointment[]
}

model Hospital {
  id        String   @id @default(uuid())
  name      String
  phone     String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctorMappings DoctorHospitalMapping[]
  medicalRecords MedicalRecord[]
  appointments   Appointment[]
}

model DoctorHospitalMapping {
  id         String @id @default(uuid())
  doctorId   String
  hospitalId String

  doctor   Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([doctorId, hospitalId])
}

model MedicalRecord {
  id          String    @id @default(uuid())
  name        String
  description String?
  fileName    String
  filePath    String
  fileType    FileType
  fileSize    Int?
  recordDate  DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  memberId     String
  recordTypeId String
  doctorId     String?
  hospitalId   String?

  member     Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordType RecordType @relation(fields: [recordTypeId], references: [id])
  doctor     Doctor?    @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  hospital   Hospital?  @relation(fields: [hospitalId], references: [id], onDelete: SetNull)

  medications Medication[]
}

model Medication {
  id        String    @id @default(uuid())
  name      String
  dosage    String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberId        String
  medicalRecordId String?

  member        Member               @relation(fields: [memberId], references: [id], onDelete: Cascade)
  medicalRecord MedicalRecord?       @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  schedules     MedicationSchedule[]
}

model MedicationSchedule {
  id        String    @id @default(uuid())
  time      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  medicationId String

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
}

model Appointment {
  id          String            @id @default(uuid())
  scheduledAt DateTime
  description String?
  status      AppointmentStatus
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  memberId   String
  doctorId   String
  hospitalId String

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  doctor   Doctor   @relation(fields: [doctorId], references: [id])
  hospital Hospital @relation(fields: [hospitalId], references: [id])
}

enum Gender {
  Male
  Female
  Other
}

enum Relationship {
  Self
  Father
  Mother
  Wife
  Husband
  Daughter
  Son
  Other
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
}

enum FileType {
  PDF
  JPEG
  JPG
  PNG
  DOCX
  XLSX
  HEIC
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}
